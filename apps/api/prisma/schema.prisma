generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Method {
  Cash
  Card
  Credit
}

enum CreditType {
  CREDIT_GIVEN
  PAYMENT_RECEIVED
}

enum StockMovementReason {
  purchase
  sale
  waste
  correction
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  label String
  roles RolePermission[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  // System roles (OWNER/ADMIN/CASHIER) are seeded once and protected from
  // edit/delete -- matches FrameX's role model. Everything else is a custom
  // role an admin created through the role-management UI.
  isSystem    Boolean          @default(false)
  createdBy   String?
  createdByUser User?          @relation("RoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy   String?
  updatedByUser User?          @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       User[]           @relation("UserRole")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id       String @id @default(uuid())
  username String @unique
  // PIN-based auth (matches FrameX) replaces the earlier password login for
  // both apps/web and apps/desktop -- bcrypt-hashed, same as passwordHash was.
  pinHash  String
  name     String
  roleId   String
  role     Role   @relation("UserRole", fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every createdBy/updatedBy back-reference below exists only so Prisma
  // can join the other side (e.g. `session.createdByUser.name`) -- none of
  // these are meant to be traversed from User outward in app code (that's
  // what ActivityLog is for: a proper chronological "what did this user
  // do" feed, not a pile of relation arrays).
  activityLogs         ActivityLog[]
  syncLogs              SyncLog[]
  createdRoles          Role[]            @relation("RoleCreatedBy")
  updatedRoles          Role[]            @relation("RoleUpdatedBy")
  createdCategories     Category[]        @relation("CategoryCreatedBy")
  updatedCategories     Category[]        @relation("CategoryUpdatedBy")
  createdStations       Station[]         @relation("StationCreatedBy")
  updatedStations       Station[]         @relation("StationUpdatedBy")
  createdSessions       Session[]         @relation("SessionCreatedBy")
  updatedSessions       Session[]         @relation("SessionUpdatedBy")
  createdExpenses       Expense[]         @relation("ExpenseCreatedBy")
  updatedExpenses       Expense[]         @relation("ExpenseUpdatedBy")
  createdCustomers      Customer[]        @relation("CustomerCreatedBy")
  updatedCustomers      Customer[]        @relation("CustomerUpdatedBy")
  createdCreditEntries  CreditEntry[]     @relation("CreditEntryCreatedBy")
  createdRates          Rate[]            @relation("RateCreatedBy")
  updatedRates          Rate[]            @relation("RateUpdatedBy")
  createdProductCategories ProductCategory[] @relation("ProductCategoryCreatedBy")
  updatedProductCategories ProductCategory[] @relation("ProductCategoryUpdatedBy")
  createdProducts       Product[]         @relation("ProductCreatedBy")
  updatedProducts       Product[]         @relation("ProductUpdatedBy")
  createdOrders         Order[]           @relation("OrderCreatedBy")
  createdStockMovements StockMovement[]   @relation("StockMovementCreatedBy")
}

// A row-level audit trail: one entry per successful create/update/delete
// applied through sync push (see sync.service.ts's applyPush) or through a
// direct admin route (user/role management). Never synced to clients --
// server-only, queried straight from Postgres by the Activity Log screen.
model ActivityLog {
  id     String @id @default(uuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id])
  // Denormalized snapshot of the actor's name at write time, so the log
  // stays readable even if that user is later renamed (there is no
  // delete-user path today, but renames already happen via the same
  // user-management UI).
  userName  String?
  action    String
  tableName String
  entityId  String
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([tableName, entityId])
}

// One row per push/pull cycle any client (desktop or web) runs against
// /sync/push or /sync/pull -- the "full sync event history" the Sync Log
// screen reads from. Same server-only, non-synced nature as ActivityLog.
model SyncLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  userName     String?
  direction    String
  entryCount   Int
  failedCount  Int      @default(0)
  errorSummary String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Category {
  id          String @id @default(uuid())
  name        String @unique
  billingType String

  createdBy     String?
  createdByUser User?   @relation("CategoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  stations Station[]
  rate     Rate?
}

model Station {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String

  createdBy     String?
  createdByUser User?   @relation("StationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("StationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  sessions Session[]

  @@index([categoryId])
}

model Session {
  id         String    @id @default(uuid())
  stationId  String
  station    Station   @relation(fields: [stationId], references: [id])
  date       String
  start      String
  end        String
  amount     Int
  method     Method?
  customerId String?
  updatedAt  DateTime  @default(now())
  deletedAt  DateTime?
  metadata   Json?
  paidAt     DateTime?

  createdBy     String?
  createdByUser User?   @relation("SessionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("SessionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([customerId])
  @@index([stationId])
}

model Expense {
  id          String    @id @default(uuid())
  date        String
  description String
  amount      Int
  method      Method
  updatedAt   DateTime  @default(now())
  deletedAt   DateTime?

  createdBy     String?
  createdByUser User?   @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("ExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([date])
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String    @default("")
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  createdBy     String?
  createdByUser User?   @relation("CustomerCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("CustomerUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model CreditEntry {
  id         String     @id @default(uuid())
  customerId String
  date       String
  type       CreditType
  amount     Int
  updatedAt  DateTime   @default(now())

  // Append-only ledger -- no update path, so no updatedBy.
  createdBy     String?
  createdByUser User?   @relation("CreditEntryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model Rate {
  id         String   @id @default(uuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id])
  hour       Int?
  half       Int?
  value      Int?
  updatedAt  DateTime @default(now())

  createdBy     String?
  createdByUser User?   @relation("RateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("RateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
}

// Cafe: a standalone point-of-sale revenue stream (snacks/drinks sold at the
// counter), deliberately NOT tied to a table Session the way FrameX ties
// cafe orders to an open session "tab" -- Cue Room's Session model has no
// running-tab/checkout step (a session row already carries its own
// amount+method), so an Order here is its own immediate pay-now transaction
// instead. Reporting is intentionally separate from Daily/Monthly Sales
// (station revenue) -- see CafeView, not DailySalesView.
model ProductCategory {
  id   String @id @default(uuid())
  name String @unique

  createdBy     String?
  createdByUser User?   @relation("ProductCategoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("ProductCategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  products Product[]
}

model Product {
  id                String          @id @default(uuid())
  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  name              String
  price             Int
  cost              Int?
  stockQty          Int             @default(0)
  lowStockThreshold Int             @default(0)
  barcode           String?
  active            Boolean         @default(true)
  updatedAt         DateTime        @default(now())
  deletedAt         DateTime?

  createdBy     String?
  createdByUser User?   @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?   @relation("ProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
}

model Order {
  id         String      @id @default(uuid())
  method     Method
  total      Int
  customerId String?
  updatedAt  DateTime    @default(now())
  deletedAt  DateTime?

  // Append-only (a checked-out order is never edited) -- no updatedBy.
  createdBy     String?
  createdByUser User?   @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([customerId])
  @@index([updatedAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int
  lineTotal Int
  updatedAt DateTime @default(now())
  metadata  Json?

  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id        String               @id @default(uuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id])
  delta     Int
  reason    StockMovementReason
  note      String?
  updatedAt DateTime             @default(now())

  // Append-only ledger -- no updatedBy.
  createdBy     String?
  createdByUser User?   @relation("StockMovementCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productId])
}
